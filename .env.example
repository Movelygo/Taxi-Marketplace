# Database
DATABASE_URL="postgresql://user:password@localhost:5432/taxilink?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (transactional email)
RESEND_API_KEY="re_your_api_key"

# Sentry (optional for Phase 0)
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_DSN="your-sentry-dsn"

# PostHog (optional for Phase 0)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Site status — controls the Coming Soon gate in middleware.ts
# - unset or "live": the real site is served (used locally and on staging/preview)
# - "coming_soon": only the Coming Soon page is served on the public domain
#   (set this ONLY in the Vercel Production environment, never locally)
NEXT_PUBLIC_SITE_STATUS=""
