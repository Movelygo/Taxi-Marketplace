// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - MUST sync with Supabase auth.users
// User.id MUST be the same UUID as auth.users.id in Supabase
model User {
  id        String   @id // UUID from Supabase Auth - NO @default(uuid())
  email     String   @unique
  role      UserRole @default(DRIVER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver Driver?

  @@map("users")
}

enum UserRole {
  DRIVER
  ADMIN
}

// City — admin-managed, replaces free-text Driver.city
model City {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  state     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  drivers      Driver[]
  serviceAreas ServiceArea[]

  @@map("cities")
}

// Driver profile
model Driver {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String             @unique
  displayName        String             @map("display_name")
  phone              String
  whatsappNumber     String             @map("whatsapp_number")
  cityId             String?            @map("city_id")
  city               String             // legacy free-text; kept for migration safety
  cityRel            City?              @relation(fields: [cityId], references: [id])
  vehicleType        String             @map("vehicle_type")        // category: Sedan / SUV-Minivan / Van / Luxury
  vehicleMake        String?            @map("vehicle_make")
  vehicleModel       String?            @map("vehicle_model")
  vehicleYear        Int?               @map("vehicle_year")
  vehicleColor       String?            @map("vehicle_color")
  passengerCapacity  Int?               @map("passenger_capacity")
  amenities          String[]           @default([])
  paymentMethods     String[]           @default([])
  operatingHours     String?            @map("operating_hours")
  languages          String[]
  bio                String?            @db.Text
  profileImageUrl    String?            @map("profile_image_url")
  status             DriverStatus       @default(PENDING)
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  isFeatured         Boolean            @default(false) @map("is_featured")
  featuredOrder      Int                @default(0) @map("featured_order")
  viewCount          Int                @default(0) @map("view_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  profileViews ProfileView[]
  leads        Lead[]
  photos       DriverPhoto[]
  reviews      Review[]
  reports      Report[]
  serviceAreas ServiceArea[]

  @@index([cityId, status, isFeatured])
  @@index([status, cityId])
  @@index([city, status, isFeatured])
  @@index([status, city])
  @@index([slug])
  @@index([userId])
  @@map("drivers")
}

// Structured service area — replaces free-text serviceAreaText
// Links drivers to the cities they serve
model ServiceArea {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  cityId    String   @map("city_id")
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([driverId, cityId])
  @@index([driverId])
  @@index([cityId])
  @@map("service_areas")
}

// Admin-managed catalog of amenities and payment methods
// Lets admin add/remove filters without code changes
model ProfileAttribute {
  id        String              @id @default(uuid())
  key       String              @unique
  label     String
  category  ProfileAttrCategory
  isActive  Boolean             @default(true) @map("is_active")
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([category, isActive, sortOrder])
  @@map("profile_attributes")
}

enum ProfileAttrCategory {
  AMENITY
  PAYMENT_METHOD
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

// Profile views tracking with deduplication support
model ProfileView {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  ipHash    String   @map("ip_hash")
  userAgent String   @map("user_agent") @db.Text
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId, createdAt])
  @@index([ipHash, driverId, createdAt])
  @@map("profile_views")
}

// Lead tracking with metadata
model Lead {
  id        String     @id @default(uuid())
  driverId  String     @map("driver_id")
  driver    Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  source    LeadSource
  ipHash    String     @map("ip_hash")
  userAgent String     @map("user_agent") @db.Text
  referrer  String?
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([driverId, createdAt])
  @@index([ipHash, driverId, createdAt])
  @@map("leads")
}

enum LeadSource {
  WHATSAPP
  CALL
}

// Contact / support inquiries from the public site
model Inquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("inquiries")
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

// Email waitlist signups from the public Coming Soon page
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("waitlist_entries")
}

// Basic ads system
model Ad {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String   @map("image_url")
  link      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("ads")
}

// Key-value configuration store for admin-managed runtime settings.
// Keeps business constants out of code and env vars where possible.
model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_configs")
}

// Vehicle photo gallery — multi-upload, ordered
// Free tier limit managed via SystemConfig.FREE_PHOTO_LIMIT (default 2)
model DriverPhoto {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId, sortOrder])
  @@map("driver_photos")
}

// ── Reviews & Reports (Phase E — Trust layer) ───────────────────────

// Customer reviews for drivers. No account required (per original vision free tier).
// Anti-fraud: 1 review per driver per IP per 24h. All reviews enter PENDING.
// Verified-contact badge: if reviewer's browser previously fired a lead-click.
model Review {
  id              String       @id @default(uuid())
  driverId        String       @map("driver_id")
  driver          Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rating          Int          // 1-5
  text            String       @db.Text
  reviewerName    String       @map("reviewer_name")
  reviewerEmail   String       @map("reviewer_email")
  ipHash          String       @map("ip_hash")
  isVerifiedContact Boolean    @default(false) @map("is_verified_contact")
  status          ReviewStatus @default(PENDING)

  // Driver public response (1 per review)
  driverResponse    String?    @db.Text @map("driver_response")
  driverRespondedAt DateTime?  @map("driver_responded_at")

  // Driver appeal / flag system
  isFlaggedByDriver Boolean           @default(false) @map("is_flagged_by_driver")
  flagReason         String?          @db.Text @map("flag_reason")
  flaggedAt          DateTime?        @map("flagged_at")
  flagStatus         ReviewFlagStatus? @map("flag_status")
  flagResolvedBy     String?          @map("flag_resolved_by")
  flagResolvedAt     DateTime?        @map("flag_resolved_at")

  createdAt    DateTime   @default(now()) @map("created_at")
  publishedAt  DateTime?  @map("published_at") // set when APPROVED
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, driverId, createdAt])
  @@index([isFlaggedByDriver, flagStatus])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewFlagStatus {
  FLAG_PENDING    // driver flagged, awaiting admin review
  FLAG_DISMISSED  // admin reviewed the flag, review stays
  FLAG_REMOVED    // admin agreed with flag, review removed
}

// Profile reports from customers/visitors. Rate-limited by ipHash.
model Report {
  id            String       @id @default(uuid())
  driverId      String       @map("driver_id")
  driver        Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reason        ReportReason
  details       String       @db.Text
  reporterEmail String?      @map("reporter_email")
  ipHash        String       @map("ip_hash")
  status        ReportStatus @default(NEW)
  adminNotes    String?      @db.Text @map("admin_notes")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, driverId, createdAt])
  @@map("reports")
}

enum ReportReason {
  NOT_A_REAL_DRIVER
  SAFETY_CONCERN
  MISLEADING_PROFILE
  INAPPROPRIATE_CONDUCT
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}
